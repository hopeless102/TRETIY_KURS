import unittest
import datetime
from datetime import timedelta
import sys

# ========== НАСТРОЙКИ ==========
DEBUG = False  # отключаем отладку для тестов
HOURLY_RATE = 100
VALID_PROMOCODES = {
    "DISABLED": "льготник (инвалид)",
    "VETERAN": "льготник (ветеран)"
}

# ========== ДАННЫЕ В ПАМЯТИ ==========
spots = [None] * 11


# ========== ОТЛАДОЧНАЯ ФУНКЦИЯ ==========
def log_debug(message):
    if DEBUG:
        print(f"[DEBUG] {message}")


# ========== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ==========
def is_spot_free(spot_num):
    """Проверить, свободно ли место"""
    return 1 <= spot_num <= 10 and spots[spot_num] is None


def check_expired_bookings():
    """Проверить и отменить просроченные брони"""
    now = datetime.datetime.now()
    expired = []
    for i in range(1, 11):
        if spots[i] is not None and spots[i]['end_time'] < now:
            expired.append(i)
    for spot in expired:
        name = spots[spot]['name']
        spots[spot] = None
        print(f"[{now.strftime('%H:%M:%S')}] Автоотмена брони: место {spot} для {name} (истекло время)")
    return len(expired)


# ========== ТЕСТЫ ==========
class TestParkingSystem(unittest.TestCase):

    def setUp(self):
        """Очистка данных перед каждым тестом"""
        for i in range(1, 11):
            spots[i] = None

    def test_is_spot_free(self):
        """Тест 1: проверка свободного места"""
        self.assertTrue(is_spot_free(5))
        self.assertFalse(is_spot_free(0))
        self.assertFalse(is_spot_free(11))

    def test_create_booking_direct(self):
        """Тест 2: создание брони напрямую (без input)"""
        start_time = datetime.datetime.now()
        end_time = start_time + timedelta(hours=2)

        spots[3] = {
            'name': 'Тест',
            'phone': '123',
            'start_time': start_time,
            'end_time': end_time,
            'hours': 2,
            'promocode': None,
            'is_free': False
        }

        self.assertIsNotNone(spots[3])
        self.assertEqual(spots[3]['name'], 'Тест')
        self.assertEqual(spots[3]['hours'], 2)

    def test_double_booking(self):
        """Тест 3: нельзя забронировать занятое место"""
        start_time = datetime.datetime.now()
        end_time = start_time + timedelta(hours=1)

        spots[5] = {
            'name': 'Первый',
            'phone': '111',
            'start_time': start_time,
            'end_time': end_time,
            'hours': 1,
            'promocode': None,
            'is_free': False
        }

        # Проверяем, что место занято
        self.assertFalse(is_spot_free(5))

    def test_promocode_valid_direct(self):
        """Тест 4: валидный промокод"""
        start_time = datetime.datetime.now()
        end_time = start_time + timedelta(hours=1)

        spots[7] = {
            'name': 'Льготник',
            'phone': '777',
            'start_time': start_time,
            'end_time': end_time,
            'hours': 1,
            'promocode': 'DISABLED',
            'is_free': True
        }

        self.assertTrue(spots[7]['is_free'])
        self.assertEqual(spots[7]['promocode'], 'DISABLED')

    def test_promocode_invalid_check(self):
        """Тест 5: неверный промокод (проверка словаря)"""
        # Проверяем, что BADCODE нет в списке валидных
        self.assertNotIn('BADCODE', VALID_PROMOCODES)
        self.assertIn('DISABLED', VALID_PROMOCODES)
        self.assertIn('VETERAN', VALID_PROMOCODES)

    def test_expired_booking(self):
        """Тест 6: просроченная бронь автоматически удаляется"""
        expired_time = datetime.datetime.now() - timedelta(hours=1)

        spots[2] = {
            'name': 'Просрочка',
            'phone': '000',
            'start_time': expired_time - timedelta(hours=2),
            'end_time': expired_time,
            'hours': 1,
            'promocode': None,
            'is_free': False
        }

        self.assertIsNotNone(spots[2])

        count = check_expired_bookings()

        self.assertEqual(count, 1)
        self.assertIsNone(spots[2])

    def test_free_spot_after_cancel(self):
        """Тест 7: отмена брони освобождает место"""
        start_time = datetime.datetime.now()
        end_time = start_time + timedelta(hours=1)

        spots[4] = {
            'name': 'Отмена',
            'phone': '444',
            'start_time': start_time,
            'end_time': end_time,
            'hours': 1,
            'promocode': None,
            'is_free': False
        }

        self.assertFalse(is_spot_free(4))

        # Отменяем бронь
        spots[4] = None

        self.assertTrue(is_spot_free(4))


def run_tests():
    """Запуск всех тестов"""
    print("\n" + "="*60)
    print("ЗАПУСК АВТОМАТИЧЕСКИХ ТЕСТОВ (parking_v2)")
    print("="*60)

    loader = unittest.TestLoader()
    suite = loader.loadTestsFromTestCase(TestParkingSystem)
    runner = unittest.TextTestRunner(verbosity=2)
    result = runner.run(suite)

    print("="*60)
    print(f"ИТОГ: Тестов выполнено: {result.testsRun}")
    print(f"Ошибок: {len(result.errors)}")
    print(f"Неудач: {len(result.failures)}")
    print(f"Успешно: {result.testsRun - len(result.errors) - len(result.failures)}")
    print("="*60)

    return result.wasSuccessful()


if __name__ == "__main__":
    success = run_tests()
    sys.exit(0 if success else 1)
