import datetime
from datetime import timedelta

# Данные в памяти
# Каждое место: None или словарь с данными брони
spots = [None] * 11  # индексы 1..10, индекс 0 не используется

# Лог действий (простой список строк)
action_log = []


def log_action(message):
    """Запись действия в лог и вывод на экран"""
    timestamp = datetime.datetime.now().strftime("%H:%M:%S")
    log_entry = f"[{timestamp}] {message}"
    action_log.append(log_entry)
    print(log_entry)


def show_free_spots():
    """Показать список свободных мест"""
    print("\n--- Свободные места ---")
    free_spots = [i for i in range(1, 11) if spots[i] is None]
    if free_spots:
        print(f"Свободны: {free_spots}")
    else:
        print("Нет свободных мест")
    return free_spots


def show_active_bookings():
    """Показать все активные брони"""
    print("\n--- Активные брони ---")
    has_bookings = False
    now = datetime.datetime.now()
    for i in range(1, 11):
        if spots[i] is not None:
            booking = spots[i]
            time_left = booking['end_time'] - now
            minutes_left = int(time_left.total_seconds() / 60)
            if minutes_left > 0:
                has_bookings = True
                print(f"Место {i}: {booking['name']} (тел. {booking['phone']}), "
                      f"осталось {minutes_left} мин, бронь до {booking['end_time'].strftime('%H:%M')}")
    if not has_bookings:
        print("Нет активных броней")
    print()


def check_expired_bookings():
    """Проверить и отменить просроченные брони"""
    now = datetime.datetime.now()
    expired = []
    for i in range(1, 11):
        if spots[i] is not None and spots[i]['end_time'] < now:
            expired.append(i)
    for spot in expired:
        name = spots[spot]['name']
        spots[spot] = None
        log_action(f"Автоотмена брони: место {spot} для {name} (истекло время)")
    return len(expired)


def is_valid_spot(spot_num):
    """Проверить, что номер места корректен"""
    return 1 <= spot_num <= 10


def is_spot_free(spot_num):
    """Проверить, свободно ли место"""
    return spots[spot_num] is None


def create_booking(name, phone, spot_num, hours):
    """Создать бронь, если место свободно"""
    if not is_valid_spot(spot_num):
        log_action(f"Ошибка: место {spot_num} не существует")
        return False
    if not is_spot_free(spot_num):
        log_action(f"Ошибка: место {spot_num} уже занято")
        return False
    if hours <= 0:
        log_action("Ошибка: время бронирования должно быть больше 0 часов")
        return False
    if hours > 24:
        log_action("Ошибка: максимальное время бронирования — 24 часа")
        return False

    start_time = datetime.datetime.now()
    end_time = start_time + timedelta(hours=hours)

    spots[spot_num] = {
        'name': name,
        'phone': phone,
        'start_time': start_time,
        'end_time': end_time,
        'hours': hours
    }
    log_action(f"Бронь создана: место {spot_num} для {name} на {hours} час(ов) (до {end_time.strftime('%H:%M')})")
    return True


def cancel_booking_by_phone(phone):
    """Отменить бронь по номеру телефона"""
    for i in range(1, 11):
        if spots[i] is not None and spots[i]['phone'] == phone:
            name = spots[i]['name']
            spots[i] = None
            log_action(f"Бронь отменена: место {i} для {name} (по номеру телефона)")
            return True
    log_action(f"Ошибка: бронь с номером {phone} не найдена")
    return False


def cancel_booking_by_spot(spot_num):
    """Отменить бронь по номеру места"""
    if not is_valid_spot(spot_num):
        log_action(f"Ошибка: место {spot_num} не существует")
        return False
    if is_spot_free(spot_num):
        log_action(f"Ошибка: место {spot_num} не забронировано")
        return False
    name = spots[spot_num]['name']
    spots[spot_num] = None
    log_action(f"Бронь отменена: место {spot_num} для {name}")
    return True


def main_menu():
    """Главное меню программы"""
    while True:
        print("\n" + "=" * 50)
        print("      СИСТЕМА УПРАВЛЕНИЯ ПАРКОВКОЙ (SmartPark)")
        print("=" * 50)
        print("1. Посмотреть свободные места")
        print("2. Забронировать место")
        print("3. Отменить бронь по номеру телефона")
        print("4. Отменить бронь по номеру места")
        print("5. Просмотреть активные брони")
        print("6. Проверить просроченные брони вручную")
        print("0. Выход")
        print("-" * 50)

        choice = input("Ваш выбор: ").strip()

        if choice == '1':
            show_free_spots()
        elif choice == '2':
            name = input("Введите ваше имя: ").strip()
            if not name:
                print("Имя не может быть пустым")
                continue
            phone = input("Введите номер телефона: ").strip()
            if not phone:
                print("Номер телефона не может быть пустым")
                continue
            show_free_spots()
            try:
                spot_num = int(input("Выберите номер места (1-10): ").strip())
                hours = float(input("На сколько часов бронировать? (1-24): ").strip())
            except ValueError:
                print("Ошибка: введите число")
                continue
            create_booking(name, phone, spot_num, hours)
        elif choice == '3':
            phone = input("Введите номер телефона для отмены брони: ").strip()
            cancel_booking_by_phone(phone)
        elif choice == '4':
            try:
                spot_num = int(input("Введите номер места для отмены брони (1-10): ").strip())
            except ValueError:
                print("Ошибка: введите число")
                continue
            cancel_booking_by_spot(spot_num)
        elif choice == '5':
            show_active_bookings()
        elif choice == '6':
            expired_count = check_expired_bookings()
            if expired_count == 0:
                print("Просроченных броней нет")
        elif choice == '0':
            print("Выход из программы. До свидания!")
            break
        else:
            print("Неверный выбор. Попробуйте снова.")


if __name__ == "__main__":
    print("Добро пожаловать в систему управления парковкой SmartPark!")
    print("(прототип, данные хранятся только в памяти)")
    main_menu()
