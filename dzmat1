#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    setlocale(LC_ALL, "ru");
    cout << "=========================================" << endl;
    cout << "Вариант 2. Задача о производстве мангалов" << endl;
    cout << "=========================================" << endl;
    cout << "Модель:" << endl;
    cout << "Z = 100*x1 + 150*x2 -> max" << endl;
    cout << "Ограничения:" << endl;
    cout << "5*x1 + 8*x2 <= 2600" << endl;
    cout << "0.8*x1 + 1.2*x2 <= 400" << endl;
    cout << "0.5*x1 + 0.5*x2 <= 200" << endl;
    cout << "x1 >= 300" << endl;
    cout << "x2 >= 300" << endl;
    cout << "x1, x2 >= 0" << endl;
    cout << "-----------------------------------------" << endl;

    vector<pair<double, double>> points;

    // Пересечения с границами x1 = 300 и x2 = 300
    points.push_back({ 300, 300 });

    // x1 = 300 с ограничениями
    // 5*300 + 8*x2 <= 2600 => 1500 + 8x2 <= 2600 => 8x2 <= 1100 => x2 <= 137.5
    points.push_back({ 300, 137.5 });
    // 0.8*300 + 1.2*x2 <= 400 => 240 + 1.2x2 <= 400 => 1.2x2 <= 160 => x2 <= 133.33
    points.push_back({ 300, 133.33 });
    // 0.5*300 + 0.5*x2 <= 200 => 150 + 0.5x2 <= 200 => 0.5x2 <= 50 => x2 <= 100
    points.push_back({ 300, 100 });

    // x2 = 300 с ограничениями
    // 5*x1 + 8*300 <= 2600 => 5x1 + 2400 <= 2600 => 5x1 <= 200 => x1 <= 40
    points.push_back({ 40, 300 });
    // 0.8*x1 + 1.2*300 <= 400 => 0.8x1 + 360 <= 400 => 0.8x1 <= 40 => x1 <= 50
    points.push_back({ 50, 300 });
    // 0.5*x1 + 0.5*300 <= 200 => 0.5x1 + 150 <= 200 => 0.5x1 <= 50 => x1 <= 100
    points.push_back({ 100, 300 });

    // Пересечения ограничений между собой
    // 5x1 + 8x2 = 2600 и 0.8x1 + 1.2x2 = 400
    // Умножим второе на 6.25: 5x1 + 7.5x2 = 2500. Вычтем из первого: 0.5x2 = 100 => x2 = 200, x1 = (2600 - 8*200)/5 = (2600-1600)/5 = 200
    points.push_back({ 200, 200 });

    // 5x1 + 8x2 = 2600 и 0.5x1 + 0.5x2 = 200 => x1 + x2 = 400 => x1 = 400 - x2
    // 5(400 - x2) + 8x2 = 2600 => 2000 - 5x2 + 8x2 = 2600 => 3x2 = 600 => x2 = 200, x1 = 200
    // Та же точка

    // 0.8x1 + 1.2x2 = 400 и 0.5x1 + 0.5x2 = 200 => x1 + x2 = 400 => x1 = 400 - x2
    // 0.8(400 - x2) + 1.2x2 = 400 => 320 - 0.8x2 + 1.2x2 = 400 => 0.4x2 = 80 => x2 = 200, x1 = 200

    double maxZ = -1;
    pair<double, double> bestPoint;

    cout << "\nАнализ вершин:\n";
    for (auto& p : points) {
        double x1 = p.first;
        double x2 = p.second;

        // Проверка ограничений
        if (x1 < 300 || x2 < 300) continue; // контракт
        if (5 * x1 + 8 * x2 > 2600 + 0.001) continue;
        if (0.8 * x1 + 1.2 * x2 > 400 + 0.001) continue;
        if (0.5 * x1 + 0.5 * x2 > 200 + 0.001) continue;

        double Z = 100 * x1 + 150 * x2;
        cout << "Точка (" << x1 << ", " << x2 << ") Z = " << Z << " - допустима" << endl;

        if (Z > maxZ) {
            maxZ = Z;
            bestPoint = p;
        }
    }

    cout << "-----------------------------------------" << endl;
    if (maxZ >= 0) {
        cout << "Оптимальное решение:" << endl;
        cout << "x1 = " << bestPoint.first << " угольных мангалов" << endl;
        cout << "x2 = " << bestPoint.second << " газовых мангалов" << endl;
        cout << "Максимальная прибыль: " << maxZ << " ден. ед." << endl;
    }
    else {
        cout << "Допустимых решений нет. Проверьте ограничения." << endl;
    }

    return 0;
}
