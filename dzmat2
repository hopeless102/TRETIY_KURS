#include <iostream>
#include <vector>
#include <algorithm>
#include <iomanip>

using namespace std;

int main() {
    setlocale(LC_ALL, "ru");
    cout << "=========================================" << endl;
    cout << "Вариант 4. Задача об обработке деталей" << endl;
    cout << "=========================================" << endl;
    cout << "Модель:" << endl;
    cout << "Z = 100*x1 + 160*x2 -> max" << endl;
    cout << "Ограничения:" << endl;
    cout << "0.2*x1 + 0.1*x2 <= 100" << endl;
    cout << "0.2*x1 + 0.5*x2 <= 180" << endl;
    cout << "0.1*x1 + 0.2*x2 <= 100" << endl;
    cout << "x1 >= 300" << endl;
    cout << "x2 <= 200" << endl;
    cout << "x1, x2 >= 0" << endl;
    cout << "-----------------------------------------" << endl;

    vector<pair<double, double>> points;

    // Пересечения с границами x1 = 300 и x2 = 200
    points.push_back({ 300, 200 });

    // x1 = 300 с ограничениями
    // 0.2*300 + 0.1*x2 <= 100 => 60 + 0.1x2 <= 100 => 0.1x2 <= 40 => x2 <= 400
    points.push_back({ 300, 400 });
    // 0.2*300 + 0.5*x2 <= 180 => 60 + 0.5x2 <= 180 => 0.5x2 <= 120 => x2 <= 240
    points.push_back({ 300, 240 });
    // 0.1*300 + 0.2*x2 <= 100 => 30 + 0.2x2 <= 100 => 0.2x2 <= 70 => x2 <= 350
    points.push_back({ 300, 350 });

    // x2 = 200 с ограничениями
    // 0.2*x1 + 0.1*200 <= 100 => 0.2x1 + 20 <= 100 => 0.2x1 <= 80 => x1 <= 400
    points.push_back({ 400, 200 });
    // 0.2*x1 + 0.5*200 <= 180 => 0.2x1 + 100 <= 180 => 0.2x1 <= 80 => x1 <= 400
    points.push_back({ 400, 200 }); // дубль
    // 0.1*x1 + 0.2*200 <= 100 => 0.1x1 + 40 <= 100 => 0.1x1 <= 60 => x1 <= 600
    points.push_back({ 600, 200 });

    // Пересечения ограничений между собой
    // 0.2x1 + 0.1x2 = 100 и 0.2x1 + 0.5x2 = 180
    // Вычтем: 0.4x2 = 80 => x2 = 200, x1 = (100 - 0.1*200)/0.2 = (100-20)/0.2 = 80/0.2 = 400
    points.push_back({ 400, 200 }); // уже есть

    // 0.2x1 + 0.1x2 = 100 и 0.1x1 + 0.2x2 = 100
    // Умножим второе на 2: 0.2x1 + 0.4x2 = 200. Вычтем первое: 0.3x2 = 100 => x2 = 1000/3 ≈ 333.33
    // x1 = (100 - 0.1*333.33)/0.2 = (100 - 33.33)/0.2 = 66.67/0.2 = 333.33
    points.push_back({ 333.33, 333.33 });

    // 0.2x1 + 0.5x2 = 180 и 0.1x1 + 0.2x2 = 100
    // Умножим второе на 2: 0.2x1 + 0.4x2 = 200. Вычтем первое: -0.1x2 = 20 => x2 = -200 (не подходит)

    double maxZ = -1;
    pair<double, double> bestPoint;

    cout << fixed << setprecision(2);
    cout << "\nАнализ вершин:\n";
    for (auto& p : points) {
        double x1 = p.first;
        double x2 = p.second;

        // Проверка ограничений
        if (x1 < 300 - 0.001 || x2 > 200 + 0.001 || x1 < 0 || x2 < 0) continue;
        if (0.2 * x1 + 0.1 * x2 > 100 + 0.001) continue;
        if (0.2 * x1 + 0.5 * x2 > 180 + 0.001) continue;
        if (0.1 * x1 + 0.2 * x2 > 100 + 0.001) continue;

        double Z = 100 * x1 + 160 * x2;
        cout << "Точка (" << x1 << ", " << x2 << ") Z = " << Z << " - допустима" << endl;

        if (Z > maxZ) {
            maxZ = Z;
            bestPoint = p;
        }
    }

    cout << "-----------------------------------------" << endl;
    if (maxZ >= 0) {
        cout << "Оптимальное решение:" << endl;
        cout << "x1 = " << bestPoint.first << " деталей А" << endl;
        cout << "x2 = " << bestPoint.second << " деталей В" << endl;
        cout << "Максимальная прибыль: " << maxZ << " ден. ед." << endl;
    }
    else {
        cout << "Допустимых решений нет. Проверьте ограничения." << endl;
    }

    return 0;
}
